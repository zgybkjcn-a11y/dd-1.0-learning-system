# Local isolated Learning Service only. Replace before starting the containers.
LEARNING_ADMIN_SECRET=replace-with-a-long-random-secret
LEARNING_ADAPTER_SECRET=replace-with-a-different-long-random-secret
LEARNING_BIND_PORT=31010

# Deterministic providers are the safe local defaults.
LEARNING_DOCUMENT_PROVIDER=mock-document-v1
LEARNING_DIAGNOSIS_PROVIDER=mock-diagnosis-v1
LEARNING_VARIANT_PROVIDER=mock-variant-v1
