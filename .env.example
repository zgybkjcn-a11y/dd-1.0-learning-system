# Local isolated Learning Service only. Replace before starting the containers.
LEARNING_ADMIN_SECRET=replace-with-a-long-random-secret
LEARNING_ADAPTER_SECRET=replace-with-a-different-long-random-secret
LEARNING_BIND_PORT=31010

# Deterministic providers are the safe local defaults. Keep this unless a
# reviewed isolated environment explicitly enables Tencent OCR egress.
LEARNING_DOCUMENT_PROVIDER=mock-document-v1
LEARNING_DIAGNOSIS_PROVIDER=mock-diagnosis-v1
LEARNING_VARIANT_PROVIDER=mock-variant-v1

# Tencent Education OCR (QuestionSplitOCR), optional. Replace placeholders
# through the runtime secret manager/environment. The egress flag stays off
# until an operator explicitly approves external calls in an isolated setup.
# LEARNING_DOCUMENT_PROVIDER=tencent-education-ocr-v1
TENCENT_OCR_SECRET_ID=replace-with-tencent-secret-id
TENCENT_OCR_SECRET_KEY=replace-with-tencent-secret-key
TENCENT_OCR_TIMEOUT_SECONDS=20
TENCENT_OCR_USE_NEW_MODEL=1
TENCENT_OCR_EXTERNAL_CALLS_ENABLED=0

# Structured diagnosis/variant adapters are optional preparation only.
# LEARNING_DIAGNOSIS_PROVIDER=openai-compatible-diagnosis-v1
# LEARNING_VARIANT_PROVIDER=openai-compatible-variant-v1
LEARNING_MODEL_EXTERNAL_CALLS_ENABLED=0
LEARNING_MODEL_ENDPOINT=
LEARNING_MODEL_ALLOWED_ENDPOINTS=
LEARNING_MODEL_API_KEY=
LEARNING_MODEL_ID=
LEARNING_MODEL_TIMEOUT_SECONDS=15
LEARNING_MODEL_MAX_ATTEMPTS=1
LEARNING_MODEL_MAX_INPUT_TOKENS=16000
LEARNING_MODEL_MAX_OUTPUT_TOKENS=1000

# Integer millionths of one currency. Zero budget disables paid calls.
# Rates/reference must be operator supplied; estimates are not invoices.
LEARNING_PROVIDER_CURRENCY=USD
LEARNING_PROVIDER_PRICING_REFERENCE=
LEARNING_PROVIDER_TOTAL_BUDGET_MICROS=0
LEARNING_PROVIDER_DAILY_BUDGET_MICROS=0
LEARNING_PROVIDER_MAX_COST_MICROS_PER_CALL=0
LEARNING_PROVIDER_MAX_CALLS_PER_DAY=0
LEARNING_PROVIDER_MAX_CALLS_PER_MINUTE=0
LEARNING_PROVIDER_MAX_INFLIGHT=1
LEARNING_MODEL_INPUT_MICROS_PER_MILLION=0
LEARNING_MODEL_OUTPUT_MICROS_PER_MILLION=0
TENCENT_OCR_COST_MICROS_PER_CALL=0

# Browser authentication requires an independently signed login gateway.
# No login gateway/production origin is configured by this example.
LEARNING_BROWSER_AUTH_ENABLED=0
LEARNING_BROWSER_AUTH_SECRET=
LEARNING_BROWSER_AUTH_ISSUER=
LEARNING_BROWSER_AUTH_AUDIENCE=dd-learning-v1
LEARNING_BROWSER_IDENTITY_PROVIDER=open-webui
LEARNING_BROWSER_IDENTITY_ISSUER=open-webui
LEARNING_BROWSER_ORIGIN=
LEARNING_BROWSER_SESSION_TTL_SECONDS=1800
LEARNING_SHARED_LEARNER_CONTEXT_ENABLED=0
LEARNING_PUBLIC_BASE_PATH=
# Login gateway is a separate process; enable only after TLS/config review.
DD_GATEWAY_ENABLED=0
DD_GATEWAY_PUBLIC_ORIGIN=
DD_GATEWAY_OPENWEBUI_URL=http://open-webui:8080
DD_GATEWAY_LEARNING_URL=http://learning-api:8000
