# Preparation template only. No environment is started by this file.
# All secrets and exact endpoints come from the runtime secret manager.
LEARNING_DEV_MODE=0
LEARNING_ADMIN_SECRET=replace-with-independent-admin-secret
LEARNING_ADAPTER_SECRET=replace-with-independent-internal-adapter-secret
LEARNING_BROWSER_AUTH_ENABLED=1
LEARNING_BROWSER_AUTH_SECRET=replace-with-independent-login-gateway-signing-secret
LEARNING_BROWSER_AUTH_ISSUER=replace-with-approved-gateway-issuer
LEARNING_BROWSER_AUTH_AUDIENCE=dd-learning-v1
LEARNING_BROWSER_IDENTITY_PROVIDER=open-webui
LEARNING_BROWSER_IDENTITY_ISSUER=open-webui
LEARNING_BROWSER_ORIGIN=https://replace-with-approved-origin.invalid
LEARNING_BROWSER_SESSION_TTL_SECONDS=1800
LEARNING_SHARED_LEARNER_CONTEXT_ENABLED=1
LEARNING_PUBLIC_BASE_PATH=/learning
DD_GATEWAY_ENABLED=0
DD_GATEWAY_PUBLIC_ORIGIN=https://replace-with-approved-origin.invalid
DD_GATEWAY_OPENWEBUI_URL=http://open-webui:8080
DD_GATEWAY_LEARNING_URL=http://learning-api:8000

LEARNING_DATA_DIR=/var/lib/dd-learning
LEARNING_DB_PATH=/var/lib/dd-learning/learning.db
LEARNING_ATTACHMENT_DIR=/var/lib/dd-learning/attachments
LEARNING_EXPORT_DIR=/var/lib/dd-learning/exports

LEARNING_DOCUMENT_PROVIDER=mock-document-v1
LEARNING_DIAGNOSIS_PROVIDER=mock-diagnosis-v1
LEARNING_VARIANT_PROVIDER=mock-variant-v1
TENCENT_OCR_EXTERNAL_CALLS_ENABLED=0
LEARNING_MODEL_EXTERNAL_CALLS_ENABLED=0
LEARNING_MODEL_ENDPOINT=
LEARNING_MODEL_ALLOWED_ENDPOINTS=
LEARNING_MODEL_API_KEY=
LEARNING_MODEL_ID=
LEARNING_PROVIDER_CURRENCY=USD
LEARNING_PROVIDER_PRICING_REFERENCE=
LEARNING_PROVIDER_TOTAL_BUDGET_MICROS=0
LEARNING_PROVIDER_DAILY_BUDGET_MICROS=0
LEARNING_PROVIDER_MAX_COST_MICROS_PER_CALL=0
LEARNING_PROVIDER_MAX_CALLS_PER_DAY=0
LEARNING_PROVIDER_MAX_CALLS_PER_MINUTE=0
LEARNING_PROVIDER_MAX_INFLIGHT=1
LEARNING_MODEL_TIMEOUT_SECONDS=15
LEARNING_MODEL_MAX_ATTEMPTS=1
LEARNING_MODEL_MAX_INPUT_TOKENS=16000
LEARNING_MODEL_MAX_OUTPUT_TOKENS=1000
LEARNING_MODEL_INPUT_MICROS_PER_MILLION=0
LEARNING_MODEL_OUTPUT_MICROS_PER_MILLION=0
TENCENT_OCR_COST_MICROS_PER_CALL=0
